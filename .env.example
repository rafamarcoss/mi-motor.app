# Solo para el runtime serverless. Nunca se carga desde GitHub Pages.
AI_PROVIDER=openai-responses
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Fallback explícito si OpenAI/Luna no está disponible.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
ROUTING_PROVIDER=openrouteservice
OPENROUTESERVICE_API_KEY=
FUEL_PROVIDER=miteco-rest

# Generación editorial en Node/GitHub Actions; no se carga en el navegador.
EDITORIAL_AI_API_KEY=
EDITORIAL_AI_BASE_URL=https://api.openai.com/v1
EDITORIAL_AI_MODEL=gpt-5.6-luna
